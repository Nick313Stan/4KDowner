{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure 4KDowner",
      "type": "shell",
      "problemMatcher": [],
      "windows": {
        "command": "cmake",
        "args": [
          "-S",
          "${workspaceFolder}",
          "-B",
          "${workspaceFolder}/build-windows",
          "-G",
          "Visual Studio 18 2026",
          "-A",
          "x64"
        ]
      },
      "linux": {
        "command": "cmake",
        "args": [
          "-S",
          "${workspaceFolder}",
          "-B",
          "${workspaceFolder}/build-linux",
          "-DCMAKE_BUILD_TYPE=Debug"
        ],
        "options": {
          "env": {
            "PATH": "/usr/bin:/bin"
          }
        }
      }
    },
    {
      "label": "Build 4KDowner",
      "dependsOn": "Configure 4KDowner",
      "type": "shell",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "windows": {
        "command": "cmake",
        "args": [
          "--build",
          "${workspaceFolder}/build-windows",
          "--config",
          "Release",
          "--target",
          "4KDowner"
        ],
        "problemMatcher": "$msCompile"
      },
      "linux": {
        "command": "cmake",
        "args": [
          "--build",
          "${workspaceFolder}/build-linux",
          "--target",
          "4KDowner",
          "-j"
        ],
        "options": {
          "env": {
            "PATH": "/usr/bin:/bin"
          }
        },
        "problemMatcher": "$gcc"
      }
    },
    {
      "label": "Build 4KDowner (Debug)",
      "dependsOn": "Configure 4KDowner",
      "type": "shell",
      "group": "build",
      "windows": {
        "command": "cmake",
        "args": [
          "--build",
          "${workspaceFolder}/build-windows",
          "--config",
          "Debug",
          "--target",
          "4KDowner"
        ],
        "problemMatcher": "$msCompile"
      },
      "linux": {
        "command": "cmake",
        "args": [
          "--build",
          "${workspaceFolder}/build-linux",
          "--target",
          "4KDowner",
          "-j"
        ],
        "options": {
          "env": {
            "PATH": "/usr/bin:/bin"
          }
        },
        "problemMatcher": "$gcc"
      }
    }
  ]
}
